# ==========================================
# PROFESIONAL .gitignore - PROYECTO CONGRESO
# ==========================================

# --- Dependencias & Entornos Virtuales ---
node_modules/
.pnp/
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/

# Python / Django
venv/
.venv/
env/
.env/
bin/
lib/
include/
*.pyc
__pycache__/
*.py[cod]
*$py.class
backend/db.sqlite3
backend/media/
backend/qr_codes/
backend/certificates/
backend/debug_serializer.log
backend/datos.json

# --- Archivos de Entorno & Sensibles ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.env.*
!.env.example

# --- Builds & Output ---
dist/
dist-ssr/
build/
out/
.next/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.local

# --- IDEs & Editores ---
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.iws
*.iml
*.ipr
.DS_Store
Thumbs.db
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# --- Archivos Temporales & Basura ---
tmp/
temp/
logs/
*.log
*.bak
*.tmp
*.temp
final_test.html
test_api.html
test_form_api.js
test_import.js
FETCH_HEAD
*.docx.md

# --- Específicos de Herramientas ---
.builder/
netlify/
.netlify/
.terraform/
.serverless/
